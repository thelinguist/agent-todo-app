{
  "name": "@todo/backend",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "prisma generate",
    "migrate": "prisma migrate deploy",
    "dev": "bun run generate && bun run migrate && tsx watch src/index.ts",
    "build": "bun run generate && bun build src/index.ts --target node --external better-sqlite3 --outdir dist",
    "start": "bun run migrate && node dist/index.js",
    "lint": "bun run generate && eslint . --max-warnings 0",
    "format": "prettier --write . --config ../prettier.config.js --ignore-path ../.prettierignore",
    "format:check": "prettier --check . --config ../prettier.config.js --ignore-path ../.prettierignore",
    "typecheck": "bun run generate && tsc --noEmit",
    "test": "bun run generate && vitest run --coverage",
    "test:api": "bun run build && bash scripts/api-tests.sh"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@hono/zod-validator": "^0.9.1",
    "@prisma/adapter-better-sqlite3": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@todo/shared": "workspace:*",
    "better-sqlite3": "^13.0.3",
    "hono": "^4.13.14",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@usebruno/cli": "^4.3.0",
    "prisma": "7.10.1",
    "tsx": "^4.23.15"
  }
}
