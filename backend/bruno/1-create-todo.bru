meta {
  name: Create todo
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/todos
  body: json
  auth: none
}

body:json {
  { "title": "Bruno todo" }
}

script:post-response {
  bru.setVar("todoId", res.body.id);
}

assert {
  res.status: eq 201
  res.body.title: eq Bruno todo
  res.body.completed: eq false
}
